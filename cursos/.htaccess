Options -Indexes
DirectoryIndex index.php

# O arquivo de configuração tem a senha do banco: nunca pode ser baixado.
<FilesMatch "^(config\.php|config\.exemplo\.php|\.user\.ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Aplicativo (PWA)
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
