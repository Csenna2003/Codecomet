# Banco PostgreSQL
DATABASE_URL="postgresql://codecomet:codecomet@localhost:5432/codecomet"

# "simulado" mostra o botão "Simular pagamento aprovado" (apenas desenvolvimento).
# Em produção use "gateway" e confirme os pedidos pelo webhook.
PAGAMENTO_MODO="simulado"

# Segredo exigido no cabeçalho x-webhook-secret de POST /api/webhooks/pagamento
WEBHOOK_SECRET="troque-este-segredo"

# Senha dos usuários de demonstração criados pelo seed
SEED_SENHA="codecomet123"
