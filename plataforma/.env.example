# Banco PostgreSQL
DATABASE_URL="postgresql://codecomet:codecomet@localhost:5432/codecomet"

# "pix": mostra QR Code e Pix copia e cola; o admin confirma em /admin/pedidos.
# "simulado": botão "Simular pagamento aprovado" (apenas desenvolvimento).
PAGAMENTO_MODO="pix"

# Dados de quem recebe o Pix. A chave deve estar exatamente como cadastrada no banco:
# CPF/CNPJ só com números, telefone como +5511999998888, e-mail ou chave aleatória.
PIX_CHAVE=""
PIX_NOME=""      # nome do titular da conta, até 25 letras, sem acentos
PIX_CIDADE=""    # cidade do titular, até 15 letras, sem acentos

# Segredo exigido no cabeçalho x-webhook-secret de POST /api/webhooks/pagamento
WEBHOOK_SECRET="troque-este-segredo"

# Senha dos usuários de demonstração criados pelo seed
SEED_SENHA="codecomet123"
